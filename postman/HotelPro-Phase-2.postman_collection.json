{
  "info": {
    "name": "HotelPro Phase 2 - Auth API",
    "description": "Register a guest, log in, and fetch the current user's profile.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register guest",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Morgan Lee\",\n  \"email\": \"morgan.lee@example.com\",\n  \"password\": \"HotelPro!2026\",\n  \"phone\": \"+14155550123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('register returns 201', function () { pm.response.to.have.status(201); });",
              "const data = pm.response.json();",
              "pm.test('response includes user and token', function () { pm.expect(data.user).to.be.an('object'); pm.expect(data.token).to.be.a('string'); });",
              "if (data.token) pm.collectionVariables.set('token', data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"morgan.lee@example.com\",\n  \"password\": \"HotelPro!2026\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login returns 200', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test('response includes user and token', function () { pm.expect(data.user).to.be.an('object'); pm.expect(data.token).to.be.a('string'); });",
              "if (data.token) pm.collectionVariables.set('token', data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get my profile",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/auth/profile"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('profile returns 200', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test('profile does not include a password', function () { pm.expect(data.user).to.be.an('object'); pm.expect(data.user).not.to.have.property('password'); });"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" }
  ]
}
