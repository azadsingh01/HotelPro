PORT=5000
NODE_ENV=development
# Replace placeholders with your MongoDB Atlas values. The database name must be hotelpro.
# URL-encode special characters in the password; never commit a real URI or password.
MONGO_URI=mongodb+srv://DB_USERNAME:URL_ENCODED_PASSWORD@CLUSTER_HOST/hotelpro?retryWrites=true&w=majority
JWT_SECRET=replace-this-with-a-unique-random-secret-of-at-least-32-bytes
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
ADMIN_SIGNUP_CODE=replace-with-a-unique-random-secret-code
